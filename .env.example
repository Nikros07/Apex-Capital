# ── OpenRouter API Keys (round-robin, 1 key per agent) ───────────────────────
# Get free keys at https://openrouter.ai → Keys
# All 5 are used for parallel agents — you can duplicate the same key if needed
OPENROUTER_KEY_1=sk-or-v1-...
OPENROUTER_KEY_2=sk-or-v1-...
OPENROUTER_KEY_3=sk-or-v1-...
OPENROUTER_KEY_4=sk-or-v1-...
OPENROUTER_KEY_5=sk-or-v1-...

# ── Gemini (optional, last-resort fallback when all OpenRouter free models
# are rate-limited — separate free daily quota from OpenRouter's) ────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or GEMINI_KEY_1..5 for round-robin across multiple free keys

# ── Tavily Web Search ─────────────────────────────────────────────────────────
# Get key at https://app.tavily.com
TAVILY_API_KEY=tvly-...

# ── Reddit API ────────────────────────────────────────────────────────────────
# Create a "script" app at https://reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ApexCapital/1.0

# ── Portfolio ─────────────────────────────────────────────────────────────────
ACCOUNT_SIZE=10000
WATCHLIST=AAPL,MSFT,NVDA,GOOGL,META,AMZN,TSLA,AMD,AVGO,QCOM,ORCL,CRM,ADBE,NFLX,INTC,JPM,BAC,V,MA,GS,MS,BRK-B,AXP,UNH,LLY,JNJ,ABBV,MRK,PFE,XOM,CVX,COP,SLB,WMT,COST,HD,MCD,PG,SPY,QQQ,IWM,XLK,XLF,GLD,PLTR,COIN,UBER,SNOW,CRWD,DDOG,RBLX,ZS,TSM,ASML,MU,NVO,SHOP,SPOT
SCAN_INTERVAL_MINUTES=15

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL / RAILWAY (has persistent disk): leave TURSO_* blank — uses a local SQLite
#   file. On Railway set DB_PATH=/data/apex.db + mount a Volume at /data.
# RENDER (no persistent disk on free tier): set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN
#   below — the app then stores everything in a free Turso database instead.
#   Create one at https://turso.tech (no credit card required):
#     turso db create apex-capital
#     turso db show apex-capital --url            → TURSO_DATABASE_URL
#     turso db tokens create apex-capital          → TURSO_AUTH_TOKEN
# DB_PATH=/data/apex.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Server (Railway/Render set PORT automatically — do not set manually there) ─
PORT=8000
